# ─────────────────────────────────────────────────────────────
# PyORB Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# Application
APP_NAME=PyORB
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=False

# Active mode: ship | control
# Can be switched at runtime by a licensed user
# Each mode uses its own database
APP_MODE=ship

# License keys (controls which modes are available)
# Leave blank to disable a mode
LICENSE_SHIP=
LICENSE_CONTROL=

# Secret keys
SECRET_KEY=change-this-secret-key-min-64-chars
JWT_SECRET=change-this-jwt-secret-min-64-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ─── DORB-Ship Database ───────────────────────────────────────
# Used when APP_MODE=ship
SHIP_DB_HOST=localhost
SHIP_DB_PORT=5432
SHIP_DB_NAME=pyorb_ship
SHIP_DB_USER=pyorb_ship_user
SHIP_DB_PASSWORD=change-this-password

# ─── DORB-Control Database ───────────────────────────────────
# Used when APP_MODE=control
# Larger DB — higher hardware requirements
CONTROL_DB_HOST=localhost
CONTROL_DB_PORT=5432
CONTROL_DB_NAME=pyorb_control
CONTROL_DB_USER=pyorb_control_user
CONTROL_DB_PASSWORD=change-this-password

# ─── Exports ─────────────────────────────────────────────────
EXPORT_PATH=./exports

# ─── External Tank Systems ───────────────────────────────────
VALMARINE_API_URL=
VALMARINE_API_KEY=
KONGSBERG_API_URL=
KONGSBERG_API_KEY=
NAPA_API_URL=
NAPA_API_KEY=

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/pyorb.log
