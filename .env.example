# PyORB Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=PyORB
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=False
SECRET_KEY=your-secret-key-here-change-this

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pyorb
DB_USER=pyorb_user
DB_PASSWORD=your-secure-password-here
DATABASE_URL=postgresql://pyorb_user:your-secure-password-here@localhost:5432/pyorb

# JWT Auth
JWT_SECRET=your-jwt-secret-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Vessel (set during initial setup)
VESSEL_NAME=
VESSEL_IMO=
VESSEL_FLAG=

# Exports
EXPORT_PATH=./exports

# External Integrations
VALMARINE_API_URL=
VALMARINE_API_KEY=
KONGSBERG_API_URL=
KONGSBERG_API_KEY=
NAPA_API_URL=
NAPA_API_KEY=

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/pyorb.log
